{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Box plots: crowd sizes at every 2026 game (rounds 1–15) involving each club, home or away. The box covers the middle half of games, the line inside is the median, whiskers reach the smallest and largest crowds. Sorted by median. Source: AFL Tables.",
  "width": "container",
  "height": {
    "step": 24
  },
  "data": {
    "url": "data/afl_matches_2026_r1-15.csv",
    "format": {
      "type": "csv",
      "parse": {
        "round": "number",
        "attendance": "number",
        "date": "date"
      }
    }
  },
  "transform": [
    {
      "fold": [
        "home_team",
        "away_team"
      ],
      "as": [
        "role",
        "club"
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "median",
          "field": "attendance",
          "as": "club_median"
        }
      ],
      "groupby": [
        "club"
      ]
    },
    {
      "calculate": "indexof(['Carlton','Collingwood','Essendon','Geelong','Hawthorn','Melbourne','North Melbourne','Richmond','St Kilda','Western Bulldogs'], datum.club) >= 0 ? 'Victorian club' : 'Interstate club'",
      "as": "group"
    }
  ],
  "encoding": {
    "y": {
      "field": "club",
      "type": "nominal",
      "title": null,
      "sort": {
        "field": "club_median",
        "op": "max",
        "order": "descending"
      },
      "axis": {
        "domain": false,
        "ticks": false,
        "labelFontSize": 12.5,
        "labelColor": "#3d3a33"
      }
    },
    "x": {
      "field": "attendance",
      "type": "quantitative",
      "title": "Crowd at games involving the club (home or away)",
      "scale": {
        "domain": [
          0,
          100000
        ]
      },
      "axis": {
        "format": ",.0f",
        "values": [
          0,
          20000,
          40000,
          60000,
          80000,
          100000
        ]
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "boxplot",
        "extent": "min-max",
        "size": 14,
        "median": {
          "color": "#fbf8f1",
          "strokeWidth": 2.5
        },
        "rule": {
          "color": "#6b665b"
        },
        "ticks": false
      },
      "encoding": {
        "color": {
          "field": "group",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Victorian club",
              "Interstate club"
            ],
            "range": [
              "#1f5fa8",
              "#d9531e"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal"
          }
        }
      }
    },
    {
      "mark": {
        "type": "circle",
        "size": 22,
        "color": "#1d1b17",
        "opacity": 0.4
      },
      "encoding": {
        "tooltip": [
          {
            "field": "club",
            "title": "Club"
          },
          {
            "field": "home_team",
            "title": "Home"
          },
          {
            "field": "away_team",
            "title": "Away"
          },
          {
            "field": "venue",
            "title": "Venue"
          },
          {
            "field": "attendance",
            "title": "Crowd",
            "format": ","
          }
        ]
      }
    }
  ],
  "background": null,
  "config": {
    "view": {
      "stroke": null
    },
    "font": "Barlow",
    "axis": {
      "labelColor": "#6b665b",
      "titleColor": "#6b665b",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 500,
      "gridColor": "#e7e1d3",
      "domainColor": "#d8d2c4",
      "tickColor": "#d8d2c4"
    },
    "legend": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "titleFontWeight": 600,
      "labelColor": "#3d3a33",
      "titleColor": "#1d1b17"
    },
    "header": {
      "labelFontSize": 13,
      "labelColor": "#1d1b17",
      "labelFontWeight": 600,
      "titleFontSize": 0
    },
    "text": {
      "color": "#3d3a33"
    }
  }
}
